    id="music"
    loop
    preload="auto"
>

    <source
        src="./song.mp3"
        type="audio/mpeg"
    >

</audio>


<script>

/* =========================================================
   ELEMENT
========================================================= */

const intro =
    document.getElementById("intro");

const nameScreen =
    document.getElementById("nameScreen");

const nameInput =
    document.getElementById("nameInput");

const nameButton =
    document.getElementById("nameButton");

const nameError =
    document.getElementById("nameError");

const envelopeScreen =
    document.getElementById("envelopeScreen");

const envelopeWrapper =
    document.getElementById("envelopeWrapper");

const envelope =
    document.getElementById("envelope");

const letterScreen =
    document.getElementById("letterScreen");

const paperTitle =
    document.getElementById("paperTitle");

const namePlaceholders =
    document.querySelectorAll(".name-placeholder");

const yesBtn =
    document.getElementById("yesBtn");

const noBtn =
    document.getElementById("noBtn");

const music =
    document.getElementById("music");

const musicButton =
    document.getElementById("musicButton");


/* =========================================================
   NAMA PENGUNJUNG
========================================================= */

let visitorName = "";


/* =========================================================
   BUKA → NAMA
========================================================= */

yesBtn.addEventListener(
    "click",
    () => {

        intro.classList.add("hide");

        setTimeout(
            () => {

                nameScreen.classList.add("show");

                setTimeout(
                    () => {

                        nameInput.focus();

                    },
                    400
                );

            },
            700
        );

    }
);


/* =========================================================
   MASUK SETELAH ISI NAMA
========================================================= */

function enterWithName() {

    const typedName =
        nameInput.value.trim();


    if (!typedName) {

        nameError.classList.add("show");

        nameInput.focus();

        return;

    }


    nameError.classList.remove("show");


    visitorName =
        typedName;


    paperTitle.textContent =
        "Untuk " + visitorName;


    namePlaceholders.forEach(
        element => {

            element.textContent =
                visitorName;

        }
    );


    /*
     * Hilangkan layar nama.
     */

    nameScreen.classList.remove("show");

    /*
     * Pastikan layar nama benar-benar
     * tidak menangkap klik.
     */

    nameScreen.style.pointerEvents =
        "none";


    /*
     * Tampilkan amplop.
     */

    setTimeout(
        () => {

            envelopeScreen.classList.add("show");

        },
        700
    );

}


nameButton.addEventListener(
    "click",
    enterWithName
);


nameInput.addEventListener(
    "keydown",
    event => {

        if (event.key === "Enter") {

            enterWithName();

        }

    }
);


nameInput.addEventListener(
    "input",
    () => {

        if (nameInput.value.trim()) {

            nameError.classList.remove("show");

        }

    }
);


/* =========================================================
   NANTI — KABUR
========================================================= */

function moveNoButton() {

    const padding = 20;

    const maxX =
        window.innerWidth -
        noBtn.offsetWidth -
        padding;

    const maxY =
        window.innerHeight -
        noBtn.offsetHeight -
        padding;

    const x =
        Math.random() *
        Math.max(maxX, padding);

    const y =
        Math.random() *
        Math.max(maxY, padding);

    noBtn.style.position =
        "fixed";

    noBtn.style.left =
        x + "px";

    noBtn.style.top =
        y + "px";
}


noBtn.addEventListener(
    "mouseenter",
    moveNoButton
);


noBtn.addEventListener(
    "touchstart",
    e => {

        e.preventDefault();

        moveNoButton();

    }
);


noBtn.addEventListener(
    "click",
    e => {

        e.preventDefault();

        moveNoButton();

    }
);


/* =========================================================
   AMPLOP — FIXED
========================================================= */

let envelopeOpened = false;

let musicPlaying = false;


envelopeWrapper.addEventListener(
    "click",
    () => {

        /*
         * Mencegah amplop diklik berkali-kali.
         */

        if (envelopeOpened) return;

        envelopeOpened = true;


        /*
         * Animasi buka amplop.
         */

        envelope.classList.add("open");


        /* =================================================
           MUSIK
           
           Musik TIDAK di-await.
           Jadi kalau song.mp3 error,
           surat tetap akan terbuka.
        ================================================= */

        const playPromise =
            music.play();


        if (playPromise !== undefined) {

            playPromise
                .then(
                    () => {

                        musicPlaying = true;

                        musicButton.textContent =
                            "Ⅱ";

                    }
                )
                .catch(
                    error => {

                        musicPlaying = false;

                        musicButton.textContent =
                            "♪";

                        console.warn(
                            "Musik gagal diputar. Surat tetap dibuka.",
                            error
                        );

                    }
                );

        }


        /*
         * Tombol musik ditampilkan.
         */

        musicButton.classList.add("show");


        /* =================================================
           PINDAH KE SURAT
        ================================================= */

        setTimeout(
            () => {

                /*
                 * Hilangkan amplop.
                 */

                envelopeScreen.classList.remove("show");


                /*
                 * Setelah transisi,
                 * tampilkan surat.
                 */

                setTimeout(
                    () => {

                        letterScreen.classList.add("show");

                    },
                    500
                );

            },
            1100
        );

    }
);


/* =========================================================
   MUSIC BUTTON
========================================================= */

musicButton.addEventListener(
    "click",
    async e => {

        /*
         * Supaya klik tombol musik
         * tidak dianggap klik amplop.
         */

        e.stopPropagation();


        if (musicPlaying) {

            music.pause();

            musicPlaying = false;

            musicButton.textContent =
                "♪";

        } else {

            try {

                await music.play();

                musicPlaying = true;

                musicButton.textContent =
                    "Ⅱ";

            } catch (error) {

                musicPlaying = false;

                musicButton.textContent =
                    "♪";

                console.warn(
                    "Musik tidak dapat diputar:",
                    error
                );

            }

        }

    }
);


/* =========================================================
   CEK ERROR AUDIO
========================================================= */

music.addEventListener(
    "error",
    () => {

        console.warn(
            "File song.mp3 tidak ditemukan atau format tidak didukung:",
            music.currentSrc
        );

    }
);


/* =========================================================
   PARALLAX
========================================================= */

document.addEventListener(
    "mousemove",
    e => {

        const x =
            (
                e.clientX /
                window.innerWidth -
                .5
            ) * 8;

        const y =
            (
                e.clientY /
                window.innerHeight -
                .5
            ) * 8;


        const nebula =
            document.querySelector(".nebula");


        if (nebula) {

            nebula.style.transform =
                `translate(
                    calc(-50% + ${x}px),
                    calc(-50% + ${y}px)
                )`;

        }

    }
);

</script>

</body>
